def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
    commands = {
        "install": cmd_install,
        "check": cmd_check,
        "encrypt": cmd_encrypt,
        "build": cmd_build,
        "dev": cmd_dev,
        "publish": cmd_publish,
        "db-migrate": cmd_db_migrate,
        "db-clean": cmd_db_clean,
        "dbclean": cmd_db_clean,
        "db-status": cmd_db_status,
        "db-demo": cmd_db_demo,
        "db-new": cmd_db_new,
        "db-query": cmd_db_query,
        "func-deploy": cmd_func_deploy,
        "help": show_help,
        "--help": show_help,
        "-h": show_help,
    }
    action = commands.get(cmd)


    if action:
        action()
    else:
        print(f"Unknown command: {cmd}\n")
        show_help()
        sys.exit(1)




