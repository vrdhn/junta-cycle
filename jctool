def cmd_db_clean(passphrase: str = "") -> None:
    """Drop all tables, triggers, and reset migration history to start afresh."""
    ensure_cached_path()
    sb_exe = BIN_DIR / "supabase"
    if not (sb_exe.is_file() and os.access(sb_exe, os.X_OK)):
        print_err("Supabase CLI not found. Run './jctool install' first.")
        sys.exit(1)

    db_url = get_db_url(passphrase)
    print_header("Cleaning Database (Dropping Tables & Resetting Migrations)")

    sql = """
    do $$
    declare
      r record;
    begin
      drop trigger if exists on_auth_user_created on auth.users;
      drop function if exists public.handle_new_user() cascade;

      for r in (select tablename from pg_tables where schemaname = 'public') loop
        execute 'drop table if exists public.' || quote_ident(r.tablename) || ' cascade';
      end loop;

      delete from auth.users where email like '%@junta.cycle';

      if exists (
        select 1 from information_schema.tables 
        where table_schema = 'supabase_migrations' and table_name = 'schema_migrations'
      ) then
        truncate table supabase_migrations.schema_migrations;
      end if;
    end $$;
    """

    cmd = [str(sb_exe), "db", "query", "--db-url", db_url, sql]
    res = subprocess.run(cmd, check=False)
    if res.returncode != 0:
        print_err("Database clean failed.")
        sys.exit(res.returncode)
    print_ok("Database successfully cleaned. All public tables dropped and migration history reset.")


