def git_tree_from_dir(directory: Path) -> str:
    """Create a git tree object directly from a directory."""
    temp_index = Path(f"/tmp/jc_git_index_{os.getpid()}")
    try:
        env = os.environ.copy()
        env["GIT_INDEX_FILE"] = str(temp_index)
        subprocess.run(["git", f"--work-tree={directory}", "add", "-A"], env=env, check=True)
        res = subprocess.run(["git", "write-tree"], env=env, capture_output=True, text=True, check=True)
        return res.stdout.strip()
    finally:
        if temp_index.exists():
            temp_index.unlink()


def publish_frontend(passphrase: str = "") -> None:
    """Build frontend and publish directly to gh-pages branch."""
    cmd_build(passphrase)
    dist_dir = Path("frontend/dist")
    if not (dist_dir / "index.html").is_file():
        print_err("frontend/dist/index.html not found after build")
        sys.exit(1)

    print("Publishing frontend to gh-pages branch...")
    tree_sha = git_tree_from_dir(dist_dir)

    run_command(["git", "fetch", "origin", "gh-pages"])
    code, parent = run_command(["git", "rev-parse", "--verify", "origin/gh-pages"])

    commit_msg = "Deploy frontend to gh-pages"
    commit_cmd = ["git", "commit-tree", tree_sha, "-m", commit_msg]
    if code == 0 and parent:
        commit_cmd.extend(["-p", parent])

    c_res = subprocess.run(commit_cmd, capture_output=True, text=True, check=True)
    commit_sha = c_res.stdout.strip()

    print(f"Pushing commit {commit_sha[:7]} to origin/gh-pages...")
    push_res = subprocess.run(["git", "push", "origin", f"{commit_sha}:refs/heads/gh-pages"], check=False)
    if push_res.returncode == 0:
        print_ok("Successfully published frontend to gh-pages!")
        print("URL: https://vrdhn.github.io/junta-cycle/")
    else:
        print_err("Failed to push frontend to gh-pages.")
        sys.exit(push_res.returncode)


def get_db_url(passphrase: str = "") -> str:
    """Retrieve direct PostgreSQL connection string using decrypted credentials."""
    config = load_config(enforce_encrypted=True)
    sb = config.get("secrets", {}).get("supabase", {})
    enc_pwd = sb.get("database-password", "")
    url = sb.get("url", "")

    if not enc_pwd:
        print_err("database-password missing in config.json")
        sys.exit(1)

    if not passphrase:
        passphrase = prompt_passphrase("Enter passphrase to decrypt database credentials: ")

    check_val = config.get("secrets", {}).get("password_check", "")
    if check_val and not verify_password(check_val, passphrase):
        print_err("Incorrect passphrase!")
        sys.exit(1)

    raw_pwd = decrypt_value(enc_pwd, passphrase)
    raw_url = decrypt_value(url, passphrase)
    encoded_pwd = urllib.parse.quote_plus(raw_pwd)

    # Extract project ref from decrypted URL (e.g. https://<ref>.supabase.co)
    project_ref = raw_url.replace("https://", "").replace("http://", "").split(".")[0]
    return f"postgresql://postgres:{encoded_pwd}@db.{project_ref}.supabase.co:5432/postgres"



def cmd_db_query(passphrase: str = "") -> None:
    """Execute a raw SQL query or file against Supabase database."""
    ensure_cached_path()
    sb_exe = BIN_DIR / "supabase"
    if not (sb_exe.is_file() and os.access(sb_exe, os.X_OK)):
        print_err(f"Supabase CLI not found. Run './jctool install' first.")
        sys.exit(1)

    db_url = get_db_url(passphrase)
    args = sys.argv[2:] if len(sys.argv) > 2 else []
    if not args:
        print("Usage: ./jctool db-query <sql-query> OR ./jctool db-query -f <sql-file>")
        sys.exit(1)

    cmd = [str(sb_exe), "db", "query", "--db-url", db_url, *args]
    res = subprocess.run(cmd, check=False)
    if res.returncode != 0:
        sys.exit(res.returncode)


