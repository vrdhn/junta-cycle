#!/usr/bin/env python3
"""junta-cycle project management tool (jctool).

Uses only Python standard library + standard openssl CLI for encryption.
"""

import getpass
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import urllib.parse
import urllib.request
from pathlib import Path

from typing import Any, Callable

CACHE_DIR = Path.home() / ".cache" / "junta-cycle"
BIN_DIR = CACHE_DIR / "bin"
NODE_DIR = CACHE_DIR / "nodejs"
NODE_BIN_DIR = NODE_DIR / "bin"
NODE_VERSION = "v22.11.0"

CONFIG_FILE = Path("config.json")
MIGRATIONS_DIR = Path("supabase/migrations")
ENC_PREFIX = "enc-v1:"

ENC_PATTERN = re.compile(r"^enc-v\d+:")

# ANSI Colors
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
BLUE = "\033[0;34m"
RESET = "\033[0m"


def print_header(title: str) -> None:
    print(f"{BLUE}=== {title} ==={RESET}")


def print_ok(message: str) -> None:
    print(f"  [{GREEN}OK{RESET}] {message}")


def print_warn(message: str) -> None:
    print(f"  [{YELLOW}WARN{RESET}] {message}")


def print_err(message: str) -> None:
    print(f"  [{RED}ERROR{RESET}] {message}")


def is_encrypted(value: str) -> bool:
    """Check if a string has the enc-v*: prefix."""
    return bool(ENC_PATTERN.match(value))


def find_unencrypted_secrets(data: Any, path: str = "secrets") -> list[str]:
    """Find any secrets values that are not encrypted."""
    unencrypted = []
    if isinstance(data, dict):
        for k, v in data.items():
            unencrypted.extend(find_unencrypted_secrets(v, f"{path}.{k}"))
    elif isinstance(data, list):
        for idx, item in enumerate(data):
            unencrypted.extend(find_unencrypted_secrets(item, f"{path}[{idx}]"))
    elif isinstance(data, str):
        if not is_encrypted(data):
            unencrypted.append(f"{path} ('{data[:10]}...' if long)")
    return unencrypted


def ensure_cached_path() -> None:
    """Prepend cached nodejs bin and tool bin to PATH if they exist."""
    cur = os.environ.get("PATH", "")
    cur_parts = cur.split(os.pathsep)
    for p in [str(BIN_DIR), str(NODE_BIN_DIR)]:
        if Path(p).is_dir() and p not in cur_parts:
            cur = f"{p}{os.pathsep}{cur}"
    os.environ["PATH"] = cur



def run_command(cmd: list[str]) -> tuple[int, str]:
    """Run a command and return exit code and stripped output."""
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
        return res.returncode, res.stdout.strip()
    except FileNotFoundError:
        return 127, ""


def openssl_cipher(args: list[str], input_str: str, passphrase: str) -> str:
    """Run openssl enc with passphrase passed via environment."""
    env = os.environ.copy()
    env["JC_CIPHER_PASS"] = passphrase
    cmd = ["openssl", "enc", *args, "-pass", "env:JC_CIPHER_PASS"]
    res = subprocess.run(
        cmd,
        input=input_str.encode("utf-8"),
        capture_output=True,
        env=env,
        check=False,
    )
    if res.returncode != 0:
        err = res.stderr.decode("utf-8", errors="replace").strip()
        raise ValueError(f"OpenSSL failed: {err}")
    try:
        return res.stdout.decode("utf-8").strip()
    except UnicodeDecodeError as exc:
        raise ValueError("Decryption failed: corrupted data or incorrect passphrase") from exc


def encrypt_value(value: str, passphrase: str) -> str:
    """Encrypt a string if not already encrypted."""
    if is_encrypted(value):
        return value
    args = ["-aes-256-cbc", "-pbkdf2", "-iter", "100000", "-salt", "-a", "-A"]
    cipher_b64 = openssl_cipher(args, value, passphrase)
    return f"{ENC_PREFIX}{cipher_b64}"


def decrypt_value(value: str, passphrase: str) -> str:
    """Decrypt a string if it starts with enc-v*: prefix."""
    if not is_encrypted(value):
        return value
    payload = value.split(":", 1)[1]
    args = ["-d", "-aes-256-cbc", "-pbkdf2", "-iter", "100000", "-salt", "-a", "-A"]
    return openssl_cipher(args, payload, passphrase)


def verify_password(check_val: str, passphrase: str) -> bool:
    """Verify provided passphrase against stored self-encrypted check secret."""
    try:
        decrypted = decrypt_value(check_val, passphrase)
        return decrypted == passphrase
    except (ValueError, Exception):
        return False


def map_secrets(data: Any, fn: Callable[[str, str], str], passphrase: str) -> Any:
    """Recursively transform string values in a secrets structure."""
    if isinstance(data, dict):
        return {k: map_secrets(v, fn, passphrase) for k, v in data.items()}
    if isinstance(data, list):
        return [map_secrets(item, fn, passphrase) for item in data]
    if isinstance(data, str):
        return fn(data, passphrase)
    return data


def prompt_passphrase(prompt_text: str) -> str:
    """Prompt for passphrase from env, interactive tty, or stdin."""
    env_pass = os.environ.get("JC_PASSPHRASE")
    if env_pass:
        return env_pass
    if sys.stdin.isatty():
        return getpass.getpass(prompt_text)
    print(prompt_text, end="", file=sys.stderr, flush=True)
    return sys.stdin.readline().rstrip("\r\n")


def load_config(enforce_encrypted: bool = True) -> dict[str, Any]:
    """Load config.json and enforce all secrets are encrypted unless enforce_encrypted is False."""
    if not CONFIG_FILE.is_file():
        return {"secrets": {"password_check": "", "supabase": {"url": "", "anon_key": ""}}}

    with open(CONFIG_FILE, "r", encoding="utf-8") as f:
        data = json.load(f)

    if enforce_encrypted and "secrets" in data:
        unencrypted = find_unencrypted_secrets(data["secrets"])
        if unencrypted:
            print_err("Unencrypted secrets found in config.json:")
            for item in unencrypted:
                print(f"    - {item}")
            print(f"\nAll secrets must be encrypted (prefix 'enc-v*:'). Run './jctool encrypt' first.")
            sys.exit(1)

    return data


def save_config(data: dict[str, Any]) -> None:
    """Save dictionary to config.json formatted with indents."""
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def cmd_encrypt() -> None:
    """Encrypt all plaintext secrets in config.json and set password_check."""
    config = load_config(enforce_encrypted=False)
    if "secrets" not in config:
        print_warn("No 'secrets' block found in config.json")
        return

    passphrase = prompt_passphrase("Enter encryption passphrase: ")
    if not passphrase:
        print_err("Passphrase cannot be empty")
        sys.exit(1)

    if not os.environ.get("JC_PASSPHRASE") and sys.stdin.isatty():
        confirm = getpass.getpass("Confirm encryption passphrase: ")
        if passphrase != confirm:
            print_err("Passphrases do not match")
            sys.exit(1)

    # If password_check already exists and was encrypted, verify passphrase before re-encrypting
    existing_check = config["secrets"].get("password_check")
    if existing_check and is_encrypted(existing_check):
        if not verify_password(existing_check, passphrase):
            print_err("Incorrect passphrase! Cannot encrypt with a different passphrase without clearing password_check.")
            sys.exit(1)

    # Set password self-encrypted check
    config["secrets"]["password_check"] = encrypt_value(passphrase, passphrase)

    # Encrypt all other secrets
    config["secrets"] = map_secrets(config["secrets"], encrypt_value, passphrase)
    save_config(config)
    print_ok(f"All secrets successfully encrypted in {CONFIG_FILE}")


def check_node() -> None:
    """Verify Node.js and npm in cache directory."""
    print("\nChecking Node runtime (managed in ~/.cache/junta-cycle):")
    node_exe = NODE_BIN_DIR / "node"
    npm_exe = NODE_BIN_DIR / "npm"

    if node_exe.is_file() and os.access(node_exe, os.X_OK):
        _, ver = run_command([str(node_exe), "-v"])
        print_ok(f"node found at {node_exe} ({ver})")
    else:
        print_err(f"node not found in {NODE_BIN_DIR} (run './jctool install' to install)")

    if npm_exe.is_file() and os.access(npm_exe, os.X_OK):
        _, ver = run_command([str(npm_exe), "-v"])
        print_ok(f"npm found at {npm_exe} ({ver})")
    else:
        print_err(f"npm not found in {NODE_BIN_DIR}")


def check_github() -> None:
    """Verify git and GitHub CLI configuration."""
    print("\nChecking GitHub credentials & git configuration:")
    code_name, git_name = run_command(["git", "config", "--get", "user.name"])
    code_email, git_email = run_command(["git", "config", "--get", "user.email"])

    if code_name == 0 and code_email == 0 and git_name and git_email:
        print_ok(f"git user configured: {git_name} <{git_email}>")
    else:
        print_warn("git user.name or user.email not configured")

    gh_code, _ = run_command(["gh", "auth", "status"])
    if gh_code == 0:
        print_ok("gh CLI authenticated")
    elif gh_code == 127:
        print_warn("gh CLI not found (optional, but helpful for GitHub automation)")
    else:
        print_warn("gh CLI installed but not authenticated ('gh auth login')")


def check_supabase() -> None:
    """Verify Supabase configuration in config.json."""
    print("\nChecking Supabase configuration:")
    if not CONFIG_FILE.is_file():
        print_warn(f"No {CONFIG_FILE} found")
        print_err("Supabase URL missing (expected in config.json)")
        print_err("Supabase Anon Key missing (expected in config.json)")
        return

    print_ok(f"Configuration file found: {CONFIG_FILE}")
    try:
        config = load_config(enforce_encrypted=True)
        sb = config.get("secrets", {}).get("supabase", {})
        url = sb.get("url", "")
        key = sb.get("anon_key", "") or sb.get("publishable_key", "")
        pwd_check = config.get("secrets", {}).get("password_check", "")

        if pwd_check:
            print_ok("Passphrase verification secret present (password_check)")
        else:
            print_err("Passphrase verification secret missing (run './jctool encrypt')")

        if url:
            print_ok("Supabase URL configured (encrypted)")
        else:
            print_err("Supabase URL missing in config.json")

        if key:
            print_ok("Supabase Publishable/Anon Key configured (encrypted)")
        else:
            print_err("Supabase Publishable/Anon Key missing in config.json")


        db_pwd = sb.get("database-password", "")
        if db_pwd:
            print_ok("Supabase Database Password configured (encrypted)")
        else:
            print_warn("Supabase Database Password missing in config.json")
    except Exception as err:
        print_err(f"Error reading {CONFIG_FILE}: {err}")

    sb_exe = BIN_DIR / "supabase"
    if sb_exe.is_file() and os.access(sb_exe, os.X_OK):
        _, ver = run_command([str(sb_exe), "--version"])
        print_ok(f"Supabase CLI installed: {ver}")
    else:
        print_warn(f"Supabase CLI not installed in {BIN_DIR} (run './jctool install' to install)")




def install_node() -> None:
    """Install Node.js into ~/.cache/junta-cycle/nodejs."""
    node_exe = NODE_BIN_DIR / "node"
    if node_exe.is_file() and os.access(node_exe, os.X_OK):
        _, ver = run_command([str(node_exe), "-v"])
        print_ok(f"Node.js already installed in {NODE_BIN_DIR}: {ver}")
        return

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    tarball_name = f"node-{NODE_VERSION}-linux-x64.tar.xz"
    url = f"https://nodejs.org/dist/{NODE_VERSION}/{tarball_name}"
    tarball_path = CACHE_DIR / tarball_name

    print(f"Downloading Node.js {NODE_VERSION} from {url}...")
    urllib.request.urlretrieve(url, tarball_path)

    print(f"Extracting into {NODE_DIR}...")
    if NODE_DIR.exists():
        shutil.rmtree(NODE_DIR)
    NODE_DIR.mkdir(parents=True, exist_ok=True)

    with tarfile.open(tarball_path, "r:xz") as tar:
        for member in tar.getmembers():
            if "/" in member.name:
                member.name = member.name.split("/", 1)[1]
                tar.extract(member, path=NODE_DIR)

    if tarball_path.is_file():
        tarball_path.unlink()

    ensure_cached_path()
    _, node_ver = run_command([str(NODE_BIN_DIR / "node"), "-v"])
    _, npm_ver = run_command([str(NODE_BIN_DIR / "npm"), "-v"])
    print_ok(f"Installed Node.js: {node_ver}")
    print_ok(f"Installed npm: {npm_ver}")


def install_supabase() -> None:
    """Install standalone Supabase CLI into ~/.cache/junta-cycle/bin."""
    BIN_DIR.mkdir(parents=True, exist_ok=True)
    sb_exe = BIN_DIR / "supabase"
    if sb_exe.is_file() and os.access(sb_exe, os.X_OK):
        _, ver = run_command([str(sb_exe), "--version"])
        print_ok(f"Supabase CLI already installed in {BIN_DIR}: {ver}")
        return

    print("Downloading Supabase CLI...")
    url = "https://github.com/supabase/cli/releases/latest/download/supabase_linux_amd64.tar.gz"
    tarball = CACHE_DIR / "supabase.tar.gz"
    urllib.request.urlretrieve(url, tarball)

    print(f"Extracting into {BIN_DIR}...")
    with tarfile.open(tarball, "r:gz") as tar:
        for member in tar.getmembers():
            if member.name == "supabase" or member.name.endswith("/supabase"):
                member.name = "supabase"
                tar.extract(member, path=BIN_DIR)

    if tarball.is_file():
        tarball.unlink()

    sb_exe.chmod(0o755)
    ensure_cached_path()
    _, ver = run_command([str(sb_exe), "--version"])
    print_ok(f"Installed Supabase CLI: {ver}")


def cmd_install() -> None:
    """Install project tools (Node.js, npm, Supabase CLI) into ~/.cache/junta-cycle."""
    print_header("junta-cycle tool (jctool)")
    machine = platform.machine().lower()
    if machine not in ("x86_64", "amd64"):
        print(f"Unsupported architecture: {machine}. Only x86_64 is configured.")
        sys.exit(1)
    install_node()
    install_supabase()



def cmd_check() -> None:
    """Run environment and credentials check."""
    ensure_cached_path()
    print_header("junta-cycle tool (jctool)")
    print("Running environment and credentials check...")
    check_node()
    check_github()
    check_supabase()
    print("\nCheck complete.")


def get_decrypted_frontend_env(passphrase: str = "") -> dict[str, str]:
    """Retrieve decrypted Supabase URL and Publishable Key for frontend build/dev."""
    url = os.environ.get("VITE_SUPABASE_URL", "")
    key = os.environ.get("VITE_SUPABASE_ANON_KEY", "")
    if url and key:
        return {"VITE_SUPABASE_URL": url, "VITE_SUPABASE_ANON_KEY": key}

    config = load_config(enforce_encrypted=True)
    sb = config.get("secrets", {}).get("supabase", {})
    enc_url = sb.get("url", "")
    enc_key = sb.get("anon_key", "") or sb.get("publishable_key", "")

    if not enc_url or not enc_key:
        print_warn("Supabase credentials not configured in config.json")
        return {}

    if not passphrase:
        passphrase = prompt_passphrase("Enter passphrase to decrypt frontend configuration: ")
    check_val = config.get("secrets", {}).get("password_check", "")
    if check_val and not verify_password(check_val, passphrase):
        print_err("Incorrect passphrase!")
        sys.exit(1)

    return {
        "VITE_SUPABASE_URL": decrypt_value(enc_url, passphrase),
        "VITE_SUPABASE_ANON_KEY": decrypt_value(enc_key, passphrase),
    }


def cmd_build(passphrase: str = "") -> None:
    """Build the frontend application into frontend/dist."""
    ensure_cached_path()
    npm_exe = NODE_BIN_DIR / "npm"
    if not npm_exe.is_file():
        print_err(f"npm not found in {NODE_BIN_DIR}. Run './jctool install' first.")
        sys.exit(1)
    frontend_env = get_decrypted_frontend_env(passphrase)
    env = {**os.environ, **frontend_env}
    print("Building frontend...")
    res = subprocess.run([str(npm_exe), "--prefix", "frontend", "run", "build"], env=env, check=False)
    if res.returncode == 0:
        dist_dir = Path("frontend/dist")
        index_html = dist_dir / "index.html"
        if index_html.is_file():
            content = index_html.read_text(encoding="utf-8")
            (dist_dir / "404.html").write_text(content, encoding="utf-8")
            # For 1-level deep subdirectories (e.g. /debug, /users), adjust relative paths to ../assets/
            sub_content = content.replace('src="./assets/', 'src="../assets/').replace('href="./assets/', 'href="../assets/')
            for sub in ("debug", "users"):
                sub_dir = dist_dir / sub
                sub_dir.mkdir(parents=True, exist_ok=True)
                (sub_dir / "index.html").write_text(sub_content, encoding="utf-8")
        print_ok("Frontend built successfully into frontend/dist (with SPA routing for /debug and /users)")
    else:
        sys.exit(res.returncode)


def cmd_dev() -> None:
    """Start frontend development server."""
    ensure_cached_path()
