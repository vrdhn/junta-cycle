def cmd_func_deploy(passphrase: str = "", fn_name: str = "") -> None:
    """Deploy Supabase Edge Functions (e.g. ./jctool func-deploy [function-name])."""
    ensure_cached_path()
    sb_exe = BIN_DIR / "supabase"
    if not (sb_exe.is_file() and os.access(sb_exe, os.X_OK)):
        print_err("Supabase CLI not found. Run './jctool install' first.")
        sys.exit(1)

    functions_dir = Path("supabase/functions")
    if not functions_dir.is_dir():
        print_warn("No supabase/functions directory found, skipping function deployment.")
        return

    config = load_config(enforce_encrypted=True)
    sb_cfg = config.get("secrets", {}).get("supabase", {})
    enc_url = sb_cfg.get("url", "")
    if not passphrase:
        passphrase = prompt_passphrase("Enter passphrase to decrypt config: ")

    check_val = config.get("secrets", {}).get("password_check", "")
    if check_val and not verify_password(check_val, passphrase):
        print_err("Incorrect passphrase!")
        sys.exit(1)

    url = decrypt_value(enc_url, passphrase)
    project_ref = url.replace("https://", "").split(".")[0]

    enc_token = sb_cfg.get("access_token", "")
    env = os.environ.copy()
    if enc_token:
        env["SUPABASE_ACCESS_TOKEN"] = decrypt_value(enc_token, passphrase)

    if not fn_name and len(sys.argv) > 2 and sys.argv[1] == "func-deploy":
        fn_name = sys.argv[2]

    target = fn_name if fn_name else "all functions"
    print_header(f"Deploying Edge Functions ({target}) -> Project: {project_ref}")
    cmd = [str(sb_exe), "functions", "deploy", "--project-ref", project_ref, "--no-verify-jwt"]
    if fn_name:
        cmd.append(fn_name)

    res = subprocess.run(cmd, env=env, check=False)
    if res.returncode != 0:
        print_err("Function deploy failed. (Note: Supabase CLI requires SUPABASE_ACCESS_TOKEN or run 'supabase login')")
        sys.exit(res.returncode)
    print_ok(f"Edge functions deployed successfully!")


def cmd_publish() -> None:
    """Publish backend migrations, edge functions, and frontend (gh-pages)."""
    print_header("junta-cycle tool (jctool publish)")
