#!/usr/bin/env python3
"""junta-cycle project management tool (jctool).

Uses only Python standard library + standard openssl CLI for encryption.
"""

import getpass
import json
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import urllib.request
from pathlib import Path
from typing import Any, Callable

CACHE_DIR = Path.home() / ".cache" / "junta-cycle"
NODE_DIR = CACHE_DIR / "nodejs"
NODE_BIN_DIR = NODE_DIR / "bin"
NODE_VERSION = "v22.11.0"
CONFIG_FILE = Path("config.json")
ENC_PREFIX = "enc-v1:"

# ANSI Colors
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
RED = "\033[0;31m"
BLUE = "\033[0;34m"
RESET = "\033[0m"


def print_header(title: str) -> None:
    print(f"{BLUE}=== {title} ==={RESET}")


def print_ok(message: str) -> None:
    print(f"  [{GREEN}OK{RESET}] {message}")


def print_warn(message: str) -> None:
    print(f"  [{YELLOW}WARN{RESET}] {message}")


def print_err(message: str) -> None:
    print(f"  [{RED}MISSING{RESET}] {message}")


def ensure_cached_path() -> None:
    """Prepend cached nodejs bin to PATH if it exists."""
    if NODE_BIN_DIR.is_dir():
        cur = os.environ.get("PATH", "")
        node_bin = str(NODE_BIN_DIR)
        if node_bin not in cur.split(os.pathsep):
            os.environ["PATH"] = f"{node_bin}{os.pathsep}{cur}"


def run_command(cmd: list[str]) -> tuple[int, str]:
    """Run a command and return exit code and stripped output."""
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
        return res.returncode, res.stdout.strip()
    except FileNotFoundError:
        return 127, ""


def openssl_cipher(args: list[str], input_str: str, passphrase: str) -> str:
    """Run openssl enc with passphrase passed via environment."""
    env = os.environ.copy()
    env["JC_CIPHER_PASS"] = passphrase
    cmd = ["openssl", "enc", *args, "-pass", "env:JC_CIPHER_PASS"]
    res = subprocess.run(
        cmd,
        input=input_str,
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    if res.returncode != 0:
        err = res.stderr.strip()
        raise ValueError(f"OpenSSL failed: {err}")
    return res.stdout.strip()


def encrypt_value(value: str, passphrase: str) -> str:
    """Encrypt a string if not already encrypted."""
    if value.startswith(ENC_PREFIX) or not value:
        return value
    args = ["-aes-256-cbc", "-pbkdf2", "-iter", "100000", "-salt", "-a", "-A"]
    cipher_b64 = openssl_cipher(args, value, passphrase)
    return f"{ENC_PREFIX}{cipher_b64}"


def decrypt_value(value: str, passphrase: str) -> str:
    """Decrypt a string if it starts with ENC_PREFIX."""
    if not value.startswith(ENC_PREFIX):
        return value
    payload = value[len(ENC_PREFIX) :]
    args = ["-d", "-aes-256-cbc", "-pbkdf2", "-iter", "100000", "-salt", "-a", "-A"]
    return openssl_cipher(args, payload, passphrase)


def map_secrets(data: Any, fn: Callable[[str, str], str], passphrase: str) -> Any:
    """Recursively transform string values in a secrets structure."""
    if isinstance(data, dict):
        return {k: map_secrets(v, fn, passphrase) for k, v in data.items()}
    if isinstance(data, list):
        return [map_secrets(item, fn, passphrase) for item in data]
    if isinstance(data, str):
        return fn(data, passphrase)
    return data


def load_config() -> dict[str, Any]:
    """Load config.json or return default empty structure."""
    if not CONFIG_FILE.is_file():
        return {"secrets": {"supabase": {"url": "", "anon_key": ""}}}
    with open(CONFIG_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


def save_config(data: dict[str, Any]) -> None:
    """Save dictionary to config.json formatted with indents."""
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def prompt_passphrase(prompt_text: str) -> str:
    """Prompt for passphrase from env, interactive tty, or stdin."""
    env_pass = os.environ.get("JC_PASSPHRASE")
    if env_pass:
        return env_pass
    if sys.stdin.isatty():
        return getpass.getpass(prompt_text)
    print(prompt_text, end="", file=sys.stderr, flush=True)
    return sys.stdin.readline().rstrip("\r\n")


def cmd_encrypt() -> None:
    """Encrypt all plaintext secrets in config.json."""
    config = load_config()
    if "secrets" not in config:
        print_warn("No 'secrets' block found in config.json")
        return

    passphrase = prompt_passphrase("Enter encryption passphrase: ")
    if not passphrase:
        print_err("Passphrase cannot be empty")
        sys.exit(1)

    # Only confirm in interactive mode if not reading from env
    if not os.environ.get("JC_PASSPHRASE") and sys.stdin.isatty():
        confirm = getpass.getpass("Confirm encryption passphrase: ")
        if passphrase != confirm:
            print_err("Passphrases do not match")
            sys.exit(1)

    config["secrets"] = map_secrets(config["secrets"], encrypt_value, passphrase)
    save_config(config)
    print_ok(f"Encrypted secrets in {CONFIG_FILE}")


def cmd_decrypt() -> None:
    """Decrypt all encrypted secrets in config.json."""
    if not CONFIG_FILE.is_file():
        print_err(f"{CONFIG_FILE} does not exist")
        sys.exit(1)

    config = load_config()
    if "secrets" not in config:
        print_warn("No 'secrets' block found in config.json")
        return

    passphrase = prompt_passphrase("Enter decryption passphrase: ")
    if not passphrase:
        print_err("Passphrase cannot be empty")
        sys.exit(1)

    try:
        config["secrets"] = map_secrets(config["secrets"], decrypt_value, passphrase)
        save_config(config)
        print_ok(f"Decrypted secrets in {CONFIG_FILE}")
    except ValueError as err:
        print_err(f"Decryption failed (incorrect passphrase or corrupted data): {err}")
        sys.exit(1)



def check_node() -> None:
    """Verify Node.js and npm in cache directory."""
    print("\nChecking Node runtime (managed in ~/.cache/junta-cycle):")
    node_exe = NODE_BIN_DIR / "node"
    npm_exe = NODE_BIN_DIR / "npm"

    if node_exe.is_file() and os.access(node_exe, os.X_OK):
        _, ver = run_command([str(node_exe), "-v"])
        print_ok(f"node found at {node_exe} ({ver})")
    else:
        print_err(f"node not found in {NODE_BIN_DIR} (run './jctool install' to install)")

    if npm_exe.is_file() and os.access(npm_exe, os.X_OK):
        _, ver = run_command([str(npm_exe), "-v"])
        print_ok(f"npm found at {npm_exe} ({ver})")
    else:
        print_err(f"npm not found in {NODE_BIN_DIR}")


def check_github() -> None:
    """Verify git and GitHub CLI configuration."""
    print("\nChecking GitHub credentials & git configuration:")
    code_name, git_name = run_command(["git", "config", "--get", "user.name"])
    code_email, git_email = run_command(["git", "config", "--get", "user.email"])

    if code_name == 0 and code_email == 0 and git_name and git_email:
        print_ok(f"git user configured: {git_name} <{git_email}>")
    else:
        print_warn("git user.name or user.email not configured")

    gh_code, _ = run_command(["gh", "auth", "status"])
    if gh_code == 0:
        print_ok("gh CLI authenticated")
    elif gh_code == 127:
        print_warn("gh CLI not found (optional, but helpful for GitHub automation)")
    else:
        print_warn("gh CLI installed but not authenticated ('gh auth login')")


def check_supabase() -> None:
    """Verify Supabase configuration in config.json."""
    print("\nChecking Supabase configuration:")
    if not CONFIG_FILE.is_file():
        print_warn(f"No {CONFIG_FILE} found")
        print_err("Supabase URL missing (expected in config.json)")
        print_err("Supabase Anon Key missing (expected in config.json)")
        return

    print_ok(f"Configuration file found: {CONFIG_FILE}")
    try:
        config = load_config()
        sb = config.get("secrets", {}).get("supabase", {})
        url = sb.get("url", "")
        key = sb.get("anon_key", "")

        if url:
            enc_str = " (encrypted)" if url.startswith(ENC_PREFIX) else ""
            print_ok(f"Supabase URL configured{enc_str}: {url}")
        else:
            print_err("Supabase URL missing in config.json (secrets.supabase.url)")

        if key:
            if key.startswith(ENC_PREFIX):
                print_ok("Supabase Anon Key configured (encrypted)")
            else:
                print_warn("Supabase Anon Key is stored in PLAINTEXT (run './jctool encrypt')")
        else:
            print_err("Supabase Anon Key missing in config.json (secrets.supabase.anon_key)")
    except Exception as err:
        print_err(f"Error reading {CONFIG_FILE}: {err}")


def cmd_install() -> None:
    """Install Node.js into ~/.cache/junta-cycle."""
    print_header("junta-cycle tool (jctool)")
    machine = platform.machine().lower()
    if machine not in ("x86_64", "amd64"):
        print(f"Unsupported architecture: {machine}. Only x86_64 is configured.")
        sys.exit(1)

    node_exe = NODE_BIN_DIR / "node"
    if node_exe.is_file() and os.access(node_exe, os.X_OK):
        _, ver = run_command([str(node_exe), "-v"])
        print_ok(f"Node.js already installed in {NODE_BIN_DIR}: {ver}")
        return

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    tarball_name = f"node-{NODE_VERSION}-linux-x64.tar.xz"
    url = f"https://nodejs.org/dist/{NODE_VERSION}/{tarball_name}"
    tarball_path = CACHE_DIR / tarball_name

    print(f"Downloading Node.js {NODE_VERSION} from {url}...")
    urllib.request.urlretrieve(url, tarball_path)

    print(f"Extracting into {NODE_DIR}...")
    if NODE_DIR.exists():
        shutil.rmtree(NODE_DIR)
    NODE_DIR.mkdir(parents=True, exist_ok=True)

    with tarfile.open(tarball_path, "r:xz") as tar:
        members = tar.getmembers()
        for member in members:
            if "/" in member.name:
                member.name = member.name.split("/", 1)[1]
                tar.extract(member, path=NODE_DIR)

    if tarball_path.is_file():
        tarball_path.unlink()

    ensure_cached_path()
    _, node_ver = run_command([str(NODE_BIN_DIR / "node"), "-v"])
    _, npm_ver = run_command([str(NODE_BIN_DIR / "npm"), "-v"])
    print_ok(f"Installed Node.js: {node_ver}")
    print_ok(f"Installed npm: {npm_ver}")


def cmd_check() -> None:
    """Run environment and credentials check."""
    ensure_cached_path()
    print_header("junta-cycle tool (jctool)")
    print("Running environment and credentials check...")
    check_node()
    check_github()
    check_supabase()
    print("\nCheck complete.")


def show_help() -> None:
    """Show CLI usage."""
    print_header("junta-cycle tool (jctool)")
    print("Usage: ./jctool <command>\n")
    print("Commands:")
    print("  install  Install Node.js & npm into ~/.cache/junta-cycle")
    print("  check    Verify required tools and credentials (Node, Git/GitHub, Supabase)")
    print("  encrypt  Encrypt plaintext secrets in config.json (prefixed with enc-v1:)")
    print("  decrypt  Decrypt encrypted secrets in config.json")
    print("  help     Show this help message")


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
    commands = {
        "install": cmd_install,
        "check": cmd_check,
        "encrypt": cmd_encrypt,
        "decrypt": cmd_decrypt,
        "help": show_help,
        "--help": show_help,
        "-h": show_help,
    }
    action = commands.get(cmd)
    if action:
        action()
    else:
        print(f"Unknown command: {cmd}\n")
        show_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
